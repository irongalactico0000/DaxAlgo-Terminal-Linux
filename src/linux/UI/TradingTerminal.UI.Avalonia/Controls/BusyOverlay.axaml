<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TradingTerminal.UI.Controls.BusyOverlay"
             x:Name="Root"
             Focusable="False">
  <UserControl.Styles>
    <!-- The active class is binding-driven, so the fixed 900 ms linear timeline starts at zero
         whenever the curtain opens and is removed completely while the overlay is idle. -->
    <Style Selector="Ellipse.busyArc.busy">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <!-- The backdrop is deliberately opaque to pointer input while visible. -->
  <Grid Background="#C8050608"
        IsVisible="{Binding IsActive, ElementName=Root}">
    <Border HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MinWidth="320"
            Padding="30,24"
            CornerRadius="0"
            Background="{DynamicResource Background.Surface}"
            BorderBrush="{DynamicResource Border.Brush}"
            BorderThickness="1"
            BoxShadow="0 0 40 0 #B3000000">
      <StackPanel HorizontalAlignment="Center">
        <!-- Fixed-size counterpart of the Windows sweeping-arc spinner. -->
        <Grid Width="46" Height="46" HorizontalAlignment="Center">
          <Ellipse Stroke="#1FFFFFFF" StrokeThickness="4" />
          <Ellipse Classes="busyArc"
                   Classes.busy="{Binding IsActive, ElementName=Root}"
                   Stroke="{DynamicResource Accent.Brush}"
                   StrokeThickness="4"
                   StrokeLineCap="Round"
                   StrokeDashArray="25.3,10.8"
                   RenderTransformOrigin="50%,50%">
            <Ellipse.RenderTransform>
              <RotateTransform Angle="0" />
            </Ellipse.RenderTransform>
          </Ellipse>
        </Grid>

        <TextBlock Margin="0,18,0,0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Text="{Binding Title, ElementName=Root}"
                   Foreground="{DynamicResource Text.Header}"
                   FontSize="15"
                   FontWeight="SemiBold" />

        <TextBlock Margin="0,6,0,0"
                   MaxWidth="360"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{Binding Message, ElementName=Root}"
                   Foreground="{DynamicResource Text.Secondary}"
                   FontSize="11.5" />

        <ProgressBar x:Name="ProgressIndicator"
                     Margin="0,14,0,0"
                     Width="260"
                     Height="3"
                     Minimum="0"
                     Maximum="100"
                     IsVisible="False"
                     Foreground="{DynamicResource Accent.Brush}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
