<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TradingTerminal.Recording.RecorderPanelView"
             Foreground="{DynamicResource Text.Primary}">
  <UserControl.Styles>
    <Style Selector="Border.rowCard">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.brokerPill">
      <Setter Property="Background" Value="{DynamicResource Background.Elevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Border.chip.live, Border.chip.available">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Bullish.Brush}" />
      <Setter Property="Background" Value="{DynamicResource Bullish.Soft}" />
    </Style>
    <Style Selector="Border.chip.l3">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="TextBlock.chipLabel">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.chipLabel.live, TextBlock.chipLabel.available">
      <Setter Property="Foreground" Value="{DynamicResource Bullish.Brush}" />
    </Style>
    <Style Selector="TextBlock.chipCount">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Foreground" Value="{DynamicResource Accent.Brush}" />
      <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Background.Surface}"
          BorderBrush="{DynamicResource Border.Strong}"
          BorderThickness="1"
          CornerRadius="0"
          Margin="10">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0"
              Padding="12,9"
              Background="{DynamicResource Gradient.Chrome}"
              BorderBrush="{DynamicResource Border.Brush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Border Width="3" Background="{DynamicResource Accent.Brush}" Margin="0,1,8,1" />
            <TextBlock Text="MARKET DATA RECORDER"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Text.Header}"
                       VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      IsVisible="{Binding Service.IsRecording}">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource Bullish.Brush}" Margin="0,0,6,0" />
            <TextBlock Text="{Binding Service.Elapsed}"
                       FontFamily="{DynamicResource Font.Mono}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Bullish.Brush}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="12,10">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Service.Instruments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="rowCard">
                  <Grid RowDefinitions="Auto,Auto,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Margin="0,1,0,0">
                          <Run Text="{Binding Category}" /><Run Text=" · " /><Run Text="{Binding Symbol}" />
                        </TextBlock>
                      </StackPanel>

                      <Border Grid.Column="1"
                              Classes="brokerPill"
                              Margin="6,0,0,0"
                              IsVisible="{Binding IsLive}"
                              ToolTip.Tip="Serving broker">
                        <TextBlock Text="{Binding ActiveBroker}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Secondary}" />
                      </Border>

                      <Button Grid.Column="2"
                              Margin="6,0,0,0"
                              Padding="4,1"
                              VerticalAlignment="Top"
                              Background="Transparent"
                              BorderThickness="0"
                              Click="OnRemoveClick"
                              ToolTip.Tip="Remove from the watchlist">
                        <TextBlock Text="×" FontSize="12" Foreground="{DynamicResource Text.Secondary}" />
                      </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                      <Border Classes="chip" Classes.live="{Binding IsLive}" ToolTip.Tip="Top-of-book quotes">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Classes="chipLabel" Classes.live="{Binding IsLive}" Text="L1" />
                          <TextBlock Classes="chipCount" Text="{Binding Quotes, StringFormat={}{0:N0}}" IsVisible="{Binding IsLive}" />
                        </StackPanel>
                      </Border>
                      <Border Classes="chip" Classes.live="{Binding IsLive}" ToolTip.Tip="1-minute bars">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Classes="chipLabel" Classes.live="{Binding IsLive}" Text="BARS" />
                          <TextBlock Classes="chipCount" Text="{Binding Bars, StringFormat={}{0:N0}}" IsVisible="{Binding IsLive}" />
                        </StackPanel>
                      </Border>
                      <Border Classes="chip" Classes.available="{Binding SupportsDepth}" ToolTip.Tip="L2 depth — order-book levels when available">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Classes="chipLabel" Classes.available="{Binding SupportsDepth}" Text="L2" />
                          <TextBlock Classes="chipCount" Text="{Binding Depth, StringFormat={}{0:N0}}" IsVisible="{Binding SupportsDepth}" />
                        </StackPanel>
                      </Border>
                      <Border Classes="chip" Classes.available="{Binding SupportsTape}" ToolTip.Tip="Trade tape — time and sales when available">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Classes="chipLabel" Classes.available="{Binding SupportsTape}" Text="TAPE" />
                          <TextBlock Classes="chipCount" Text="{Binding Trades, StringFormat={}{0:N0}}" IsVisible="{Binding SupportsTape}" />
                        </StackPanel>
                      </Border>
                      <Border Classes="chip l3" ToolTip.Tip="No broker in this build exposes L3 / market-by-order">
                        <TextBlock Classes="chipLabel" Text="L3" />
                      </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="{Binding Status}"
                               FontSize="10"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="The watchlist is empty — add an instrument below to start building a tape."
                     FontSize="11"
                     Foreground="{DynamicResource Text.Secondary}"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Margin="8,14"
                     IsVisible="{Binding !Service.HasInstruments}" />

          <Button Height="46"
                  Classes="quiet"
                  Command="{Binding BeginAddCommand}"
                  IsVisible="{Binding !IsAdding}"
                  ToolTip.Tip="Add an instrument to the watchlist">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock Text="+" FontSize="15" FontWeight="Bold" Margin="0,0,7,1" />
              <TextBlock Text="Add" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Border Background="{DynamicResource Gradient.Elevated}"
                  BorderBrush="{DynamicResource Border.Strong}"
                  BorderThickness="1"
                  CornerRadius="0"
                  Padding="10,8"
                  IsVisible="{Binding IsAdding}">
            <StackPanel Spacing="7">
              <StackPanel Orientation="Horizontal">
                <Border Width="3" Background="{DynamicResource Accent.Brush}" Margin="0,1,8,1" />
                <TextBlock Text="ADD INSTRUMENT"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Text.Header}"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBox Watermark="Search instruments"
                       Text="{Binding InstrumentSearchText, Mode=TwoWay}" />
              <ComboBox ItemsSource="{Binding Instruments}"
                        SelectedItem="{Binding SelectedInstrument, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding DisplayName}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Contract.Symbol}"
                                 Foreground="{DynamicResource Text.Secondary}"
                                 Margin="12,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                <Button Content="Add" Classes="quiet accent" Command="{Binding ConfirmAddCommand}" />
                <Button Content="Cancel" Classes="quiet" Command="{Binding CancelAddCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2"
              Padding="12,10"
              Background="#14FFFFFF"
              BorderBrush="{DynamicResource Border.Brush}"
              BorderThickness="0,1,0,0">
        <StackPanel>
          <Button Height="36"
                  FontSize="12"
                  FontWeight="Bold"
                  Command="{Binding ToggleRecordingCommand}"
                  BorderBrush="{DynamicResource Danger.Brush}"
                  Background="#14FFFFFF"
                  Foreground="{DynamicResource Danger.Brush}"
                  IsVisible="{Binding !Service.IsRecording}"
                  Content="●  RECORD"
                  ToolTip.Tip="Start recording the watchlist into the canonical store. Recording keeps running when this panel is closed." />
          <Button Height="36"
                  FontSize="12"
                  FontWeight="Bold"
                  Command="{Binding ToggleRecordingCommand}"
                  BorderBrush="{DynamicResource Bullish.Brush}"
                  Background="{DynamicResource Bullish.Soft}"
                  Foreground="{DynamicResource Bullish.Brush}"
                  IsVisible="{Binding Service.IsRecording}"
                  Content="■  STOP"
                  ToolTip.Tip="Stop recording the watchlist." />

          <CheckBox Content="Auto upload on Telegram"
                    FontSize="11"
                    Margin="0,10,0,0"
                    IsChecked="{Binding Service.AutoUploadTelegram, Mode=TwoWay}"
                    ToolTip.Tip="Ships recorded data to Telegram every hour." />
          <CheckBox Content="Delete local copy after upload"
                    FontSize="11"
                    Margin="22,5,0,0"
                    IsChecked="{Binding Service.DeleteLocalAfterUpload, Mode=TwoWay}"
                    IsEnabled="{Binding Service.AutoUploadTelegram}"
                    ToolTip.Tip="Off means Telegram is a second copy; on means uploaded data is pruned locally." />

          <TextBlock Text="{Binding Service.Status}"
                     FontSize="10"
                     Foreground="{DynamicResource Text.Secondary}"
                     TextWrapping="Wrap"
                     Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
