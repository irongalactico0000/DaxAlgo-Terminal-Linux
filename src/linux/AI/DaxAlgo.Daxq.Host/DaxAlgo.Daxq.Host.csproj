<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Description>Official-installer host for verified, sealed DAXQ strategy packages.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DaxAlgo.Daxq.Contracts\DaxAlgo.Daxq.Contracts.csproj" />
    <ProjectReference Include="..\DaxAlgo.Daxq.Vm\DaxAlgo.Daxq.Vm.csproj" />
    <ProjectReference Include="..\..\Core\TradingTerminal.Core\TradingTerminal.Core.csproj" />
    <ProjectReference Include="..\..\Pipeline\TradingTerminal.Infrastructure\TradingTerminal.Infrastructure.csproj" />
    <ProjectReference Include="..\..\UI\TradingTerminal.UI.Core\TradingTerminal.UI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DaxAlgo.Daxq.Host.Tests" />
    <AssemblyMetadata Include="DaxqNativeVmSha256"
                      Value="$(DaxqNativeVmSha256)"
                      Condition="'$(DaxqNativeVmSha256)' != ''" />
    <AssemblyMetadata Include="DaxqNativeVmPublisherSha256"
                      Value="$(DaxqNativeVmPublisherSha256)"
                      Condition="'$(DaxqNativeVmPublisherSha256)' != ''" />
    <AssemblyMetadata Include="DaxqNativeVmMacTeamIdentifier"
                      Value="$(DaxqNativeVmMacTeamIdentifier)"
                      Condition="'$(DaxqNativeVmMacTeamIdentifier)' != ''" />
  </ItemGroup>

</Project>
