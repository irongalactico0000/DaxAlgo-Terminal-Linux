<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:TradingTerminal.App.Avalonia.Strategies"
        x:Class="TradingTerminal.App.Avalonia.Strategies.StrategyPresentationEditorWindow"
        Title="Edit strategy card"
        Width="580" Height="680" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background.Primary}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Font.Mono}"
        FontSize="12">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <Border Width="3" Height="15" Background="{DynamicResource Accent.Brush}" Margin="0,0,8,0" />
        <TextBlock Text="EDIT STRATEGY CARD" FontWeight="Bold" FontSize="13"
                   Foreground="{DynamicResource Text.Header}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Margin="11,4,0,0" FontSize="11" Foreground="{DynamicResource Text.Secondary}"
                 TextWrapping="Wrap">
        <Run Text="Customises this catalog card. Blank name and description use the strategy defaults. Id: " />
        <Run Text="{Binding StrategyId}" Foreground="{DynamicResource Text.Highlight}" />
      </TextBlock>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,4,0" Spacing="3">
        <TextBlock Text="Name" FontWeight="SemiBold" />
        <TextBox Text="{Binding Name}" />

        <TextBlock Text="Tags (comma-separated)" FontWeight="SemiBold" Margin="0,9,0,0" />
        <TextBox Text="{Binding TagsText}"
                 ToolTip.Tip="Free-text labels shown on the card, for example mean-reversion, intraday, HFT." />

        <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,9,0,0" />
        <TextBox Text="{Binding Description}" MinHeight="80" MaxHeight="180"
                 AcceptsReturn="True" TextWrapping="Wrap" />

        <TextBlock Text="Public link (optional)" FontWeight="SemiBold" Margin="0,9,0,0" />
        <TextBox Text="{Binding LinkUrl}"
                 ToolTip.Tip="An HTTPS seller page, documentation, source, social profile, or research paper." />

        <TextBlock Text="Alpha-generating formula (optional)" FontWeight="SemiBold" Margin="0,9,0,0" />
        <TextBox Text="{Binding Formula}" MinHeight="60" MaxHeight="160"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 FontFamily="Menlo,Consolas,monospace" />

        <TextBlock Text="UI image (screenshot)" FontWeight="SemiBold" Margin="0,9,0,0" />
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBox Grid.Column="0" Text="{Binding ImagePath}" VerticalContentAlignment="Center" />
          <Button Grid.Column="1" Content="Browse..." Padding="12,5" Margin="6,0,0,0"
                  Command="{Binding BrowseImageCommand}" />
          <Button Grid.Column="2" Content="Clear" Padding="12,5" Margin="6,0,0,0"
                  Command="{Binding ClearImageCommand}" />
        </Grid>
        <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                   Text="No image? The card shows the DaxAlgo logo instead." />
        <local:StrategyImageTile Height="150" Width="260" HorizontalAlignment="Left"
                                 ImagePath="{Binding ImagePath}" Margin="0,5,0,0" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14,0,0">
      <Button Grid.Column="0" Content="Reset to default" Padding="12,6"
              Command="{Binding ResetToDefaultCommand}" />
      <Button Grid.Column="2" Content="Cancel" Padding="16,6" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button Grid.Column="3" Content="Save" Padding="20,6" Click="Save_Click"
              Background="{DynamicResource Accent.Brush}" Foreground="{DynamicResource Background.Primary}" />
    </Grid>
  </Grid>
</Window>
