<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Background.Primary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Base}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Base}" />
  </Style>
  <Style Selector="TextBlock.header">
    <Setter Property="Foreground" Value="{DynamicResource Text.Header}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{DynamicResource Text.Header}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Data}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource Gradient.Elevated}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Gradient.Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Gradient.AccentHover}" />
    <Setter Property="TextBlock.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.ai">
    <Setter Property="Background" Value="{DynamicResource Gradient.AiGlass}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ai.Accent.Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="18,10" />
  </Style>

  <Style Selector="Border.fnkey">
    <Setter Property="Background" Value="{DynamicResource Gradient.Accent}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Padding" Value="8,5" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Background.Elevated}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Accent.Brush}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Background.Elevated}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource Background.Elevated}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
</Styles>
