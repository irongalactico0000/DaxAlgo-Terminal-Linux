<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TradingTerminal.App.Avalonia.Settings.SupportWindow"
        Width="520" Height="600"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background.Primary}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Font.Mono}"
        FontSize="12"
        Title="Support the developer">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
      <TextBlock Text="DAXALGO" Foreground="{DynamicResource Accent.Brush}"
                 FontWeight="Bold" FontSize="16" />
      <TextBlock Text=" TERMINAL" Foreground="{DynamicResource Text.Primary}"
                 FontWeight="Bold" FontSize="16" Margin="0,0,10,0" />
      <TextBlock Text="{Binding Version}" Foreground="{DynamicResource Text.Secondary}"
                 FontSize="12" VerticalAlignment="Center" />
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{Binding ThankYouMessage}" TextWrapping="Wrap"
               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,18" LineHeight="18" />

    <TextBlock Grid.Row="2" Text="Write to the developer"
               Foreground="{DynamicResource Accent.Brush}" FontWeight="Bold" Margin="0,0,0,6" />

    <Border Grid.Row="3" BorderBrush="{DynamicResource Border.Brush}" BorderThickness="1"
            Background="{DynamicResource Background.Elevated}">
      <TextBox Text="{Binding FeedbackText}" AcceptsReturn="True" TextWrapping="Wrap"
               ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent"
               Foreground="{DynamicResource Text.Primary}" BorderThickness="0" Padding="8"
               Watermark="Feature ideas, bugs, or just a hello — it all reaches me." />
    </Border>

    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap"
               Foreground="{DynamicResource Accent.Brush}" Margin="0,8,0,0" />

    <Border Grid.Row="5" Background="{DynamicResource Background.Elevated}"
            BorderBrush="{DynamicResource Border.Brush}" BorderThickness="1"
            Padding="10" Margin="0,14,0,0">
      <TextBlock Text="{Binding DonateMessage}" TextWrapping="Wrap"
                 Foreground="{DynamicResource Text.Secondary}" FontSize="11" />
    </Border>

    <Grid Grid.Row="6" Margin="0,16,0,0" ColumnDefinitions="Auto,*,Auto,Auto">
      <Button Grid.Column="0" Content="GITHUB" Command="{Binding OpenGitHubCommand}" Padding="14,6" />
      <Button Grid.Column="2" Content="Send to developer" Command="{Binding SendFeedbackCommand}"
              Background="{DynamicResource Accent.Brush}" BorderBrush="{DynamicResource Accent.Brush}"
              Foreground="White" Padding="16,6" Margin="0,0,8,0" />
      <Button Grid.Column="3" Content="MAYBE LATER" Command="{Binding CloseCommand}" Padding="16,6" />
    </Grid>
  </Grid>
</Window>
