<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:TradingTerminal.App.Avalonia.Settings"
        x:Class="TradingTerminal.App.Avalonia.Settings.StrategyAuthoringWindow"
        Width="1100" Height="760"
        MinWidth="1000" MinHeight="680"
        Background="{DynamicResource Background.Primary}"
        Foreground="{DynamicResource Text.Primary}"
        Title="Vibe Quant — AI strategy builder"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <local:ParameterKindMatchConverter x:Key="ParameterKindMatch" />
    <local:PositiveCountConverter x:Key="PositiveCount" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Border.rail">
      <Setter Property="Background" Value="{StaticResource Gradient.Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Brush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.workbench">
      <Setter Property="Background" Value="{StaticResource Background.Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Brush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Border.composer">
      <Setter Property="Background" Value="{StaticResource Background.Elevated}" />
      <Setter Property="BorderBrush" Value="{StaticResource Ai.Glow.Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.message">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="MaxWidth" Value="650" />
    </Style>
    <Style Selector="Border.userMessage">
      <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent.Brush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.assistantMessage">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.systemMessage">
      <Setter Property="Background" Value="{StaticResource Ai.Soft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Strong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{StaticResource Background.Elevated}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Strong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Brush}" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Button.pill">
      <Setter Property="Background" Value="{StaticResource Background.Elevated}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Strong}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="10.5" />
    </Style>
    <Style Selector="Button.pill.aiPill">
      <Setter Property="BorderBrush" Value="{StaticResource Ai.Glow.Brush}" />
      <Setter Property="Foreground" Value="{StaticResource Ai.Text.Brush}" />
    </Style>
    <Style Selector="Button.aiAction">
      <Setter Property="Background" Value="{StaticResource Gradient.Ai}" />
      <Setter Property="BorderBrush" Value="{StaticResource Ai.Accent.Brush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="ListBox.chromeLess">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem.session">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="ListBoxItem.fileTab">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Data}" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0">
      <Border x:Name="SimulatedDataBanner" Background="#B45309"
              Padding="12,6" IsVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="&#x26A0;" Foreground="White" FontWeight="Bold" />
          <TextBlock Text="SIMULATED DATA — not a live feed"
                     Foreground="White" FontWeight="SemiBold" />
        </StackPanel>
      </Border>

      <Border Padding="14,9"
              Background="{StaticResource Background.Surface}"
              BorderBrush="{StaticResource Border.Brush}" BorderThickness="0,0,0,1"
              AutomationProperties.Name="Authoring screen navigation">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{Binding ActiveScreenTitle}" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="{Binding ActiveScreenDescription}" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                      IsVisible="{Binding ShowScreenNavigation}">
            <Button Classes="pill" Content="1  Design &amp; Confirm"
                    Command="{Binding OpenDesignScreenCommand}"
                    IsEnabled="{Binding CanOpenDesignScreen}"
                    AutomationProperties.Name="Open Design and Confirm screen" />
            <TextBlock Text="→" Classes="caption" VerticalAlignment="Center" />
            <Button Classes="aiAction" Content="2  Build, Test &amp; Compare"
                    Command="{Binding OpenBuildScreenCommand}"
                    IsEnabled="{Binding CanOpenBuildScreen}"
                    AutomationProperties.Name="Open Build Test and Compare screen"
                    ToolTip.Tip="Loads retained native evidence when configured; legacy draft generation still requires a confirmed request." />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,4,390">
      <!-- Session rail: an expanded history view and a compact icon strip share one column. -->
      <Border Grid.Column="0" Classes="rail" Width="234"
              IsVisible="{Binding !RailCollapsed}">
        <DockPanel Margin="10,12,10,10">
          <StackPanel DockPanel.Dock="Top" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Width="30" Height="30" Background="{StaticResource Gradient.Ai}"
                      CornerRadius="7">
                <TextBlock Text="VQ" Foreground="White" FontWeight="Bold" FontSize="10"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Vibe Quant" Classes="header" FontSize="13" />
                <TextBlock Text="AI strategy builder" Classes="caption" />
              </StackPanel>
              <Button Grid.Column="2" Classes="ghost" Content="‹" FontSize="18"
                      Command="{Binding ToggleRailCommand}" ToolTip.Tip="Collapse session rail" />
            </Grid>

            <Button Classes="aiAction" Content="＋  New strategy"
                    IsEnabled="{Binding !IsGenerating}"
                    Command="{Binding NewChatCommand}" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="5" Margin="0,10,0,0">
            <Border BorderBrush="{StaticResource Border.Brush}" BorderThickness="0,1,0,0"
                    Padding="2,9,2,0">
              <StackPanel Spacing="5">
                <TextBlock Text="PROVIDERS" Classes="eyebrow" />
                <ItemsControl ItemsSource="{Binding AiProviders}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                        <Grid Grid.Column="0" Width="12" Height="12">
                          <Ellipse Width="6" Height="6" Fill="{StaticResource Text.Secondary}"
                                   IsVisible="{Binding !IsAvailable}" />
                          <Ellipse Width="6" Height="6" Fill="{StaticResource Bullish.Brush}"
                                   IsVisible="{Binding IsAvailable}" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Classes="caption"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <ListBox Classes="chromeLess" ItemsSource="{Binding SavedSessions}"
                   IsEnabled="{Binding !IsGenerating}"
                   SelectedItem="{Binding SelectedSavedSession, Mode=TwoWay}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,2" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Background.Elevated}"
                        BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                        CornerRadius="5" Padding="9,7" Margin="0,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" FontFamily="{StaticResource Font.Data}">
                        <Run Text="{Binding StrategyId}" /><Run Text="  ·  " /><Run Text="{Binding Age}" />
                      </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" Content="×" Padding="5,1"
                            Tag="{Binding}" Click="OnDeleteSession"
                            ToolTip.Tip="Delete this conversation only" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="0" Classes="rail" Width="50"
              IsVisible="{Binding RailCollapsed}">
        <StackPanel Margin="7,12" Spacing="10">
          <Border Width="34" Height="34" Background="{StaticResource Gradient.Ai}" CornerRadius="7">
            <Button Content="VQ" Foreground="White" FontSize="9" FontWeight="Bold"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    Command="{Binding ToggleRailCommand}" ToolTip.Tip="Expand session rail" />
          </Border>
          <Button Classes="aiAction" Content="＋" Padding="0" Width="34" Height="34"
                  IsEnabled="{Binding !IsGenerating}"
                  Command="{Binding NewChatCommand}" ToolTip.Tip="New strategy" />
        </StackPanel>
      </Border>

      <!-- Agent canvas. -->
      <Grid Grid.Column="1" Margin="16,10,12,12" RowDefinitions="Auto,*,Auto,Auto"
            IsVisible="{Binding IsDesignScreen}"
            AutomationProperties.Name="Design and Confirm screen">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,8"
              IsVisible="{Binding HasConversation}">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}" Classes="header" FontSize="14"
                       TextTrimming="CharacterEllipsis" />
            <Border Classes="chip">
              <TextBlock Text="{Binding ModelPillText}" FontSize="9.5"
                         Foreground="{StaticResource Ai.Text.Brush}" />
            </Border>
          </StackPanel>
          <Border Grid.Column="1" Classes="chip" BorderBrush="{StaticResource Ai.Glow.Brush}"
                  IsVisible="{Binding IsGenerating}">
            <TextBlock FontFamily="{StaticResource Font.Data}" FontSize="10"
                       Foreground="{StaticResource Ai.Text.Brush}">
              <Run Text="WORKING  " /><Run Text="{Binding ElapsedCompact}" />
            </TextBlock>
          </Border>
        </Grid>

        <Grid Grid.Row="1">
          <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        IsVisible="{Binding HasConversation}">
            <ItemsControl ItemsSource="{Binding Messages}" Margin="2,0,8,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Border Classes="message userMessage" HorizontalAlignment="Right"
                            IsVisible="{Binding IsUser}">
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="18" />
                    </Border>
                    <Border Classes="message assistantMessage" HorizontalAlignment="Left"
                            IsVisible="{Binding IsAssistant}">
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="18" />
                    </Border>
                    <Border Classes="message systemMessage" HorizontalAlignment="Left"
                            IsVisible="{Binding IsSystem}">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding ToolTitle}" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource Ai.Text.Brush}" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ToolDetail}" Classes="caption" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding PlanTasks}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="72,*" Margin="0,2">
                                <TextBlock Text="{Binding State}" FontFamily="{StaticResource Font.Data}"
                                           FontSize="10" Foreground="{StaticResource Ai.Text.Brush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="10.5" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding FileChanges}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="chip" Margin="0,3,5,0">
                                <TextBlock FontFamily="{StaticResource Font.Data}" FontSize="10">
                                  <Run Text="{Binding Name}" /><Run Text="  " />
                                  <Run Text="{Binding Counts}" Foreground="{StaticResource Bullish.Brush}" />
                                </TextBlock>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel IsVisible="{Binding !HasConversation}" VerticalAlignment="Center"
                      HorizontalAlignment="Center" MaxWidth="600">
            <Border Width="46" Height="46" Background="{StaticResource Gradient.Ai}"
                    CornerRadius="12" HorizontalAlignment="Center">
              <TextBlock Text="VQ" FontSize="16" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Describe the strategy. Watch it get built."
                       Classes="header" FontSize="16.5" HorizontalAlignment="Center" Margin="0,14,0,4" />
            <TextBlock Text="Start from an idea across strategy family, horizon, market topology, and data — then edit the brief before four AI agents build alternatives."
                       Classes="muted" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" />

            <Grid Margin="0,16,0,0" RowDefinitions="Auto,Auto,Auto,*"
                  IsVisible="{Binding AiHasProvider}">
              <TextBox Grid.Row="0" Text="{Binding StarterSearchText, Mode=TwoWay}"
                       Watermark="Search 22 ideas — momentum, pairs, options, execution…"
                       MinHeight="32" />
              <Grid Grid.Row="1" ColumnDefinitions="*,*,*,Auto" Margin="0,7,0,0">
                <ComboBox Grid.Column="0" ItemsSource="{Binding StarterFamilyOptions}"
                          SelectedItem="{Binding SelectedStarterFamily, Mode=TwoWay}"
                          MinWidth="150" Margin="0,0,6,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding StarterHorizonOptions}"
                          SelectedItem="{Binding SelectedStarterHorizon, Mode=TwoWay}" Margin="0,0,6,0" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding StarterDataOptions}"
                          SelectedItem="{Binding SelectedStarterData, Mode=TwoWay}" Margin="0,0,6,0" />
                <Button Grid.Column="3" Classes="ghost" Content="Clear"
                        Command="{Binding ClearStarterFiltersCommand}" />
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="2,7,2,3">
                <TextBlock Text="STRATEGY STARTERS BY AXIS" Classes="eyebrow" />
                <TextBlock Grid.Column="1" Text="{Binding StarterResultText}"
                           Classes="caption" FontFamily="{StaticResource Font.Data}" />
              </Grid>
              <ListBox Grid.Row="3" Classes="chromeLess" MaxHeight="300"
                       ItemsSource="{Binding VisibleStarterBriefs}"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="pill" Margin="0,3" Padding="11,8"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Tag="{Binding}" Click="OnUseStarter">
                      <Grid RowDefinitions="Auto,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11.5"
                                     TextTrimming="CharacterEllipsis" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding AxisLabels.Horizon}" Classes="caption"
                                       FontFamily="{StaticResource Font.Data}" />
                            <TextBlock Text="{Binding AxisLabels.Topology}" Classes="caption"
                                       FontFamily="{StaticResource Font.Data}" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Summary}" Classes="caption"
                                   TextWrapping="Wrap" MaxLines="2" Margin="0,3,0,0" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,5,0,0">
                          <ItemsControl ItemsSource="{Binding FamilyLabels}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Classes="chip" Margin="0,0,4,0">
                                  <TextBlock Text="{Binding}" FontSize="9" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl ItemsSource="{Binding AxisLabels.Data}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding}" Classes="caption" Margin="0,0,5,0" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <Border Background="{StaticResource Ai.Soft}" BorderBrush="{StaticResource Ai.Glow.Brush}"
                    BorderThickness="1" CornerRadius="7" Padding="12,10" Margin="0,18,0,0"
                    IsVisible="{Binding !AiHasProvider}">
              <TextBlock TextWrapping="Wrap" FontSize="11.5">
                <Run Text="No AI provider is set up yet. " FontWeight="SemiBold" />
                <Run Text="Add an API key or install an agent CLI under Settings → AI providers, then come back — or write the strategy yourself in the workbench and press Compile &amp; Register." />
              </TextBlock>
            </Border>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="4,8,4,0" Spacing="4">
          <Border Background="{StaticResource Ai.Soft}" BorderBrush="{StaticResource Ai.Glow.Brush}"
                  BorderThickness="1" CornerRadius="4" Padding="8,5"
                  IsVisible="{Binding AwaitingAnswer}">
            <TextBlock Text="The strategy still needs one of your choices — reply below."
                       FontWeight="SemiBold" TextWrapping="Wrap" />
          </Border>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"
                        IsVisible="{Binding IsGenerating}">
              <TextBlock Text="{Binding WorkingVerb}" Foreground="{StaticResource Ai.Text.Brush}"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding StepText}" Classes="caption" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ElapsedText}" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding UsageText}" Classes="caption"
                       FontFamily="{StaticResource Font.Data}" />
          </Grid>
          <TextBlock Text="{Binding AiStatus}" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="3" Classes="composer" Padding="11,9" Margin="0,10,0,0">
          <Grid RowDefinitions="Auto,Auto">
            <TextBox x:Name="ComposerBox" Grid.Row="0" MinHeight="58" MaxHeight="190"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="Transparent" BorderThickness="0" Padding="2"
                     FontSize="12.5" Watermark="Describe the strategy — or refine what's there. ⌘/Ctrl+Enter sends."
                     Text="{Binding Composer, Mode=TwoWay}"
                     KeyDown="OnComposerKeyDown" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                         IsEnabled="{Binding !IsGenerating}">
                <Border Background="{StaticResource Ai.Soft}"
                        BorderBrush="{StaticResource Ai.Glow.Brush}" BorderThickness="1"
                        CornerRadius="14" Padding="10,4" Margin="0,0,6,4">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="&#x2726;" Foreground="{StaticResource Ai.Text.Brush}" />
                    <TextBlock Text="{Binding GenerationModeLabel}"
                               Foreground="{StaticResource Ai.Text.Brush}"
                               FontWeight="SemiBold" FontSize="10.5" />
                  </StackPanel>
                </Border>
                <Button Classes="ghost" Content="{Binding GenerationModeActionText}"
                        Command="{Binding ToggleGenerationModeCommand}"
                        Padding="6,3" FontSize="9.5" Margin="0,0,6,4"
                        ToolTip.Tip="Switch generation workflow. Four candidates compares editable artifacts; Expert Code writes C# directly." />

                <Button Classes="pill aiPill" Margin="0,0,6,4"
                        ToolTip.Tip="Choose the provider and model.">
                  <TextBlock>
                    <Run Text="◇ " /><Run Text="{Binding ModelPillText}" /><Run Text="  ▾" />
                  </TextBlock>
                  <Button.Flyout>
                    <Flyout Placement="Top">
                      <Border MinWidth="340" MaxWidth="440" Padding="10"
                              Background="{StaticResource Background.Surface}"
                              BorderBrush="{StaticResource Border.Strong}" BorderThickness="1" CornerRadius="7">
                        <StackPanel Spacing="7">
                          <ComboBox ItemsSource="{Binding AiProviders}"
                                    SelectedItem="{Binding SelectedAiProvider, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="10.5" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <ListBox ItemsSource="{Binding AllModels}"
                                   SelectedItem="{Binding SelectedModelChoice, Mode=TwoWay}"
                                   MaxHeight="260" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Display}" FontFamily="{StaticResource Font.Data}"
                                           FontSize="10.5" TextTrimming="CharacterEllipsis" />
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="Custom id:" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" FontFamily="{StaticResource Font.Data}" FontSize="10.5"
                                     Text="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <Button Grid.Column="2" Classes="ghost" Content="↻"
                                    Command="{Binding RefreshModelsCommand}" ToolTip.Tip="Refresh models" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </Flyout>
                  </Button.Flyout>
                </Button>

                <Button Classes="pill" Margin="0,0,6,4" ToolTip.Tip="Builder effort.">
                  <TextBlock><Run Text="Build: " /><Run Text="{Binding BuildEffort}" /><Run Text="  ▾" /></TextBlock>
                  <Button.Flyout>
                    <Flyout Placement="Top">
                      <ListBox MinWidth="150" Padding="6" ItemsSource="{Binding BuildEfforts}"
                               SelectedItem="{Binding BuildEffort, Mode=TwoWay}" />
                    </Flyout>
                  </Button.Flyout>
                </Button>

                <Button Classes="pill" Margin="0,0,6,4"
                        IsEnabled="{Binding EffortSupported}" ToolTip.Tip="Model reasoning effort.">
                  <TextBlock><Run Text="Reasoning: " /><Run Text="{Binding SelectedEffort}" /><Run Text="  ▾" /></TextBlock>
                  <Button.Flyout>
                    <Flyout Placement="Top">
                      <ListBox MinWidth="150" Padding="6" ItemsSource="{Binding Efforts}"
                               SelectedItem="{Binding SelectedEffort, Mode=TwoWay}" />
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </WrapPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Bottom" Margin="0,0,0,4">
                <Button Content="■  Stop" Command="{Binding StopCommand}"
                        IsVisible="{Binding IsGenerating}" />
                <Button Classes="aiAction" Content="{Binding SendButtonText}" Command="{Binding SendCommand}"
                        IsVisible="{Binding !IsGenerating}" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch"
                    Background="Transparent" IsVisible="{Binding IsDesignScreen}" />

      <!-- Multi-file workbench. -->
      <Border Grid.Column="{Binding WorkbenchGridColumn}"
              Grid.ColumnSpan="{Binding WorkbenchGridColumnSpan}"
              Classes="workbench">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="13,12,13,10"
                  BorderBrush="{StaticResource Border.Brush}" BorderThickness="0,0,0,1">
            <Grid>
              <StackPanel Spacing="7" IsVisible="{Binding ShowDesignRequestHeader}">
              <TextBlock Text="SCREEN 1 · STRATEGY REQUEST" Classes="eyebrow" />
              <TextBlock Text="Review the interpreted idea, answer the material strategy questions, and confirm the request before implementation."
                         Classes="caption" TextWrapping="Wrap" />
              <Border Background="{StaticResource Ai.Soft}"
                      BorderBrush="{StaticResource Ai.Glow.Brush}" BorderThickness="1"
                      CornerRadius="5" Padding="8,6">
                <TextBlock Text="{Binding StrategyIntentStatusText}" Classes="caption" TextWrapping="Wrap" />
              </Border>
              </StackPanel>

              <StackPanel Spacing="5" IsVisible="{Binding ShowNativeImplementationHeader}"
                          AutomationProperties.Name="Native strategy run screen header">
                <TextBlock Text="SCREEN 2 · RETAINED NATIVE RUN" Classes="eyebrow" />
                <TextBlock Text="Inspect one already confirmed Research → VibeQuant/AKQuant + CSP → Compare run. This screen does not yet create that run from the chart or Design chat."
                           Classes="caption" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding ShowImplementationHeader}">
              <TextBlock Text="SCREEN 2 · BUILD, TEST &amp; COMPARE" Classes="eyebrow" />
              <Grid ColumnDefinitions="2*,8,3*">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="STRATEGY ID" Classes="eyebrow" />
                  <TextBox Text="{Binding StrategyId, Mode=TwoWay}"
                           IsEnabled="{Binding !IsGenerating}"
                           FontFamily="{StaticResource Font.Data}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Text="DISPLAY NAME" Classes="eyebrow" />
                  <TextBox Text="{Binding DisplayName, Mode=TwoWay}"
                           IsEnabled="{Binding !IsGenerating}" />
                </StackPanel>
              </Grid>

              <Button Classes="aiAction" Content="⚡  Compile &amp; Register"
                      Command="{Binding CompileCommand}"
                      IsEnabled="{Binding CanCompileCurrentSource}"
                      IsVisible="{Binding HasExpertCSharpFiles}"
                      ToolTip.Tip="Compile every file, then review before registration" />

              <Border Background="{StaticResource Warning.Soft}"
                      BorderBrush="{StaticResource Warning.Brush}" BorderThickness="1"
                      CornerRadius="5" Padding="8,6"
                      IsVisible="{Binding HasDetachedImplementationSource}"
                      AutomationProperties.Name="Detached implementation source warning">
                <StackPanel Spacing="2">
                  <TextBlock Text="SOURCE BELONGS TO THE PREVIOUS REQUEST"
                             Foreground="{StaticResource Warning.Brush}"
                             FontWeight="SemiBold" FontSize="10" />
                  <TextBlock Text="It remains available for inspection, but it is not an implementation of the current confirmed request. Generate a new bound implementation, or explicitly switch to Expert C# to keep it as an unbound draft."
                             Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Background="{StaticResource Background.Elevated}"
                      BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                      CornerRadius="5" Padding="8,6"
                      IsVisible="{Binding !GenerateCandidateFirst}"
                      AutomationProperties.Name="Expert C sharp mode notice">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                    <TextBlock Text="EXPERT C# MODE" Classes="eyebrow" />
                    <TextBlock Text="Candidate comparison is hidden, not deleted. Return to inspect the four AI artifacts."
                               Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost"
                          Content="Return to candidates"
                          Command="{Binding ToggleGenerationModeCommand}"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Return to Strategy Builder" />
                </Grid>
              </Border>

              <Border Background="{StaticResource Warning.Soft}"
                      BorderBrush="{StaticResource Warning.Brush}" BorderThickness="1"
                      CornerRadius="5" Padding="8,6"
                      IsVisible="{Binding HasNonCSharpExpertArtifact}"
                      AutomationProperties.Name="Non C sharp source review boundary">
                <StackPanel Spacing="2">
                  <TextBlock Text="SOURCE REVIEW · NOT C# COMPILABLE"
                             Foreground="{StaticResource Warning.Brush}"
                             FontWeight="SemiBold" FontSize="10" />
                  <TextBlock Text="The editor contains a generated Python/JSON artifact. No importer or runtime is installed for this file type, so Compile &amp; Register is unavailable."
                             Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Background="{StaticResource Ai.Soft}" BorderBrush="{StaticResource Ai.Glow.Brush}"
                      BorderThickness="1" CornerRadius="5" Padding="8,6"
                      IsVisible="{Binding ShowLegacyCandidateBoundary}">
                <TextBlock Text="Four AI generation agents: Vibe Python, declarative rules, TradeIR graph, and CSP. Every structurally valid artifact can be chosen; package validation is reported separately, and choosing never tests or runs it."
                           Classes="caption" TextWrapping="Wrap" />
              </Border>

              <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Classes="chip" Background="{StaticResource Warning.Soft}">
                  <Grid>
                    <TextBlock Text="DRAFT" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource Warning.Brush}"
                               IsVisible="{Binding !IsRegistered}" />
                    <TextBlock Text="REGISTERED" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource Bullish.Brush}"
                               IsVisible="{Binding IsRegistered}" />
                  </Grid>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding AuthoringBoundaryText}" Classes="caption"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{Binding Status}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <Border x:Name="CliWorkspaceFooter" DockPanel.Dock="Bottom" Padding="12,7"
                  BorderBrush="{StaticResource Border.Brush}" BorderThickness="0,1,0,0"
                  IsVisible="{Binding ShowCliWorkspaceFooter}">
            <ScrollViewer MaxHeight="84"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="5">
                <TextBlock Text="OPEN WORKSPACE IN" Classes="eyebrow" />
                <ItemsControl ItemsSource="{Binding AvailableClis}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="ghost" Margin="0,0,5,5" Content="{Binding DisplayName}"
                              Tag="{Binding}" Click="OnLaunchCli" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <TabControl SelectedIndex="{Binding WorkbenchTab, Mode=TwoWay}"
                      Margin="10,5,10,8" Background="Transparent">
            <TabItem Header="Code" IsVisible="{Binding ShowImplementationTabs}">
              <Grid Margin="0,6,0,0" RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                  <ListBox Grid.Column="0" Classes="chromeLess"
                           ItemsSource="{Binding Files}"
                           SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                           HorizontalAlignment="Stretch">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,4" />
                        <Setter Property="Margin" Value="0,0,4,0" />
                        <Setter Property="FontFamily" Value="{StaticResource Font.Data}" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Data}"
                                   FontSize="10.5" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Classes="ghost" Content="＋" Command="{Binding AddFileCommand}"
                            IsEnabled="{Binding !IsGenerating}"
                            ToolTip.Tip="Add helper file" />
                    <Button Classes="ghost" Content="−" Command="{Binding RemoveFileCommand}"
                            IsEnabled="{Binding !IsGenerating}"
                            CommandParameter="{Binding SelectedFile}" ToolTip.Tip="Remove selected file" />
                  </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource Background.Elevated}"
                        BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                        CornerRadius="4" Margin="0,6,0,0">
                  <TextBox Text="{Binding SelectedFile.Content, Mode=TwoWay}"
                           IsEnabled="{Binding !IsGenerating}"
                           AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           Background="Transparent" BorderThickness="0" Padding="11,9"
                           FontFamily="{StaticResource Font.Data}" FontSize="12.2" />
                </Border>

                <Expander Grid.Row="2" Margin="0,6,0,0" IsExpanded="True"
                          IsVisible="{Binding Diagnostics.Count, Converter={StaticResource PositiveCount}}">
                  <Expander.Header>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Warning.Brush}">
                      <Run Text="⚠ Diagnostics · " /><Run Text="{Binding Diagnostics.Count}" />
                      <Run Text="  (select a row to jump to its file)" Foreground="{StaticResource Text.Secondary}" />
                    </TextBlock>
                  </Expander.Header>
                  <ListBox ItemsSource="{Binding Diagnostics}" MaxHeight="130"
                           SelectedItem="{Binding SelectedDiagnostic, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="52,88,34,*" Margin="0,2">
                          <TextBlock Grid.Column="0" Text="{Binding Severity}" FontSize="10"
                                     Foreground="{StaticResource Warning.Brush}" />
                          <TextBlock Grid.Column="1" Text="{Binding File}" Classes="caption"
                                     FontFamily="{StaticResource Font.Data}" />
                          <TextBlock Grid.Column="2" Text="{Binding Line}" Classes="caption"
                                     FontFamily="{StaticResource Font.Data}" />
                          <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="10.5"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Expander>
              </Grid>
            </TabItem>

            <TabItem Header="Parameters" IsVisible="{Binding ShowImplementationTabs}">
              <Grid Margin="0,8,0,0" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,7">
                  <TextBlock Grid.Column="0" Text="Compile a strategy with a static Schema to edit its tunables."
                             Classes="caption" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Classes="ghost" Content="Reset defaults"
                          Command="{Binding Parameters.ResetToDefaultsCommand}" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Parameters.Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource Background.Elevated}"
                                BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                CornerRadius="4" Padding="9,7" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="*,150">
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" />
                              <TextBlock Classes="caption" FontFamily="{StaticResource Font.Data}">
                                <Run Text="{Binding Key}" /><Run Text="  " /><Run Text="{Binding Unit}" />
                              </TextBlock>
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                              <NumericUpDown Value="{Binding NumberValue, Mode=TwoWay}"
                                             Minimum="{Binding Min}" Maximum="{Binding Max}"
                                             Increment="{Binding Step}"
                                             IsVisible="{Binding Kind, Converter={StaticResource ParameterKindMatch}, ConverterParameter=Integer|Number}" />
                              <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" Content="Enabled"
                                        IsVisible="{Binding Kind, Converter={StaticResource ParameterKindMatch}, ConverterParameter=Boolean}" />
                              <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                        IsVisible="{Binding Kind, Converter={StaticResource ParameterKindMatch}, ConverterParameter=Choice}" />
                              <TextBox Text="{Binding TextValue, Mode=TwoWay}"
                                       IsVisible="{Binding Kind, Converter={StaticResource ParameterKindMatch}, ConverterParameter=Text}" />
                            </Grid>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </TabItem>

            <TabItem Header="Activity" IsVisible="{Binding ShowImplementationTabs}">
              <Grid Margin="0,8,0,0" RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,8">
                  <TextBlock Text="BUILD TASKS" Classes="eyebrow" />
                  <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="70,*" Margin="0,2">
                          <TextBlock Grid.Column="0" Text="{Binding State}" FontSize="10"
                                     FontFamily="{StaticResource Font.Data}"
                                     Foreground="{StaticResource Ai.Text.Brush}" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="10.5" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource Background.Elevated}"
                        BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                        CornerRadius="4" Padding="9">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Activity}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" Classes="caption" TextWrapping="Wrap"
                                     FontFamily="{StaticResource Font.Data}" Margin="0,2" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </Grid>
            </TabItem>

            <TabItem Header="{Binding CandidateTabHeader}">
              <Grid Margin="0,8,0,0" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Grid.RowSpan="2"
                        IsVisible="{Binding ShowNativeStrategyRunPanel}"
                        Background="{StaticResource Background.Base}"
                        BorderBrush="{StaticResource Ai.Glow.Brush}" BorderThickness="1"
                        CornerRadius="6" Padding="10"
                        AutomationProperties.Name="Native strategy retained run evidence">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Margin="0,0,4,0">
                      <Border Background="{StaticResource Warning.Soft}"
                              BorderBrush="{StaticResource Warning.Brush}" BorderThickness="1"
                              CornerRadius="5" Padding="8,7"
                              AutomationProperties.Name="Native strategy UI limitation">
                        <StackPanel Spacing="2">
                          <TextBlock Text="RETAINED RUN BRIDGE · PARTIAL UI WIRING"
                                     Foreground="{StaticResource Warning.Brush}"
                                     FontWeight="SemiBold" FontSize="10" />
                          <TextBlock Text="Chart selection, frozen-context research chat, and user confirmation are not connected to this screen yet. Load an already confirmed run ID; every status, event, error, artifact hash, and report below comes from the native service."
                                     Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                        <TextBox Grid.Column="0" Text="{Binding NativeRunId, Mode=TwoWay}"
                                 Watermark="Confirmed retained run ID"
                                 FontFamily="{StaticResource Font.Data}"
                                 AutomationProperties.Name="Native strategy run ID" />
                        <Button Grid.Column="1" Classes="aiAction" Content="Load run"
                                Command="{Binding LoadNativeRunCommand}" Margin="7,0,0,0"
                                AutomationProperties.Name="Load retained native strategy run" />
                        <Button Grid.Column="2" Classes="ghost" Content="Refresh"
                                Command="{Binding RefreshNativeRunCommand}" Margin="7,0,0,0"
                                AutomationProperties.Name="Refresh retained native strategy run" />
                        <Button Grid.Column="3" Classes="ghost" Content="Start"
                                Command="{Binding StartNativeRunCommand}" Margin="7,0,0,0"
                                AutomationProperties.Name="Start confirmed native strategy run" />
                        <Button Grid.Column="4" Classes="ghost" Content="Request cancel"
                                Command="{Binding CancelNativeRunCommand}" Margin="7,0,0,0"
                                AutomationProperties.Name="Request native strategy run cancellation" />
                      </Grid>

                      <Border Background="{StaticResource Background.Elevated}"
                              BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                              CornerRadius="5" Padding="8,7">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding NativeRunIdentityText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding NativeRunStatus}"
                                       FontFamily="{StaticResource Font.Data}" Classes="caption"
                                       Margin="8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding NativeEvidenceStatus}"
                                       FontFamily="{StaticResource Font.Data}" Classes="caption" />
                          </Grid>
                          <TextBlock Text="{Binding NativeRunLoadStatus}" Classes="caption"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding NativeEventDisplayBoundary}" Classes="caption"
                                     TextWrapping="Wrap" />
                          <Border IsVisible="{Binding NativeResearchSessionUnavailable}"
                                  Background="{StaticResource Warning.Soft}"
                                  BorderBrush="{StaticResource Warning.Brush}" BorderThickness="1"
                                  CornerRadius="4" Padding="6,4"
                                  AutomationProperties.Name="Research session restart fallback">
                            <TextBlock Text="{Binding NativeResearchAvailabilityText}"
                                       Foreground="{StaticResource Warning.Brush}"
                                       TextWrapping="Wrap" />
                          </Border>
                          <TextBlock Classes="caption" FontFamily="{StaticResource Font.Data}"
                                     TextWrapping="Wrap">
                            <Run Text="Manifest SHA-256  " />
                            <Run Text="{Binding NativeManifestSha256}" />
                          </TextBlock>
                          <TextBlock IsVisible="{Binding HasNativeRunFailure}"
                                     Foreground="{StaticResource Warning.Brush}"
                                     TextWrapping="Wrap">
                            <Run Text="{Binding NativeRunFailureCode}" FontWeight="SemiBold" />
                            <Run Text="  " />
                            <Run Text="{Binding NativeRunFailureDetail}" />
                          </TextBlock>
                        </StackPanel>
                      </Border>

                      <ItemsControl ItemsSource="{Binding NativeStrategyEvidencePanels}"
                                    AutomationProperties.Name="Research VibeQuant CSP Compare native panels">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Margin="3" Padding="9,8"
                                    Background="{StaticResource Background.Elevated}"
                                    BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                    CornerRadius="5">
                              <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="*,Auto">
                                  <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Authority}" Classes="caption"
                                               TextWrapping="Wrap" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Spacing="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                               FontFamily="{StaticResource Font.Data}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Stage}" Classes="caption"
                                               FontFamily="{StaticResource Font.Data}"
                                               HorizontalAlignment="Right" />
                                  </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Summary}" Classes="caption"
                                           TextWrapping="Wrap" />
                                <Border IsVisible="{Binding HasExactFailure}"
                                        Background="{StaticResource Warning.Soft}"
                                        BorderBrush="{StaticResource Warning.Brush}" BorderThickness="1"
                                        CornerRadius="4" Padding="6,4">
                                  <StackPanel Spacing="2">
                                    <TextBlock Text="EXACT NATIVE FAILURE" Classes="eyebrow"
                                               Foreground="{StaticResource Warning.Brush}" />
                                    <TextBlock Text="{Binding ExactFailure}" TextWrapping="Wrap" />
                                  </StackPanel>
                                </Border>
                                <TextBox Text="{Binding Evidence, Mode=OneWay}" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         FontFamily="{StaticResource Font.Data}"
                                         MinHeight="100" MaxHeight="150"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="{Binding Title}" />
                                <TextBlock Text="RETAINED EVENTS" Classes="eyebrow" />
                                <ItemsControl ItemsSource="{Binding Events}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Border BorderBrush="{StaticResource Border.Brush}"
                                              BorderThickness="0,1,0,0" Padding="0,4">
                                        <StackPanel Spacing="1">
                                          <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding StageStatusText}"
                                                       FontFamily="{StaticResource Font.Data}"
                                                       FontSize="9.5" />
                                            <TextBlock Grid.Column="1" Text="{Binding TimestampText}"
                                                       Classes="caption"
                                                       FontFamily="{StaticResource Font.Data}" />
                                          </Grid>
                                          <TextBlock Text="{Binding Message}" Classes="caption"
                                                     TextWrapping="Wrap" />
                                          <TextBlock Text="{Binding Details}" Classes="caption"
                                                     FontFamily="{StaticResource Font.Data}"
                                                     TextWrapping="Wrap" MaxHeight="54" />
                                        </StackPanel>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Border Background="{StaticResource Background.Elevated}"
                              BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                              CornerRadius="5" Padding="8,7"
                              AutomationProperties.Name="Hash checked retained artifact viewer">
                        <StackPanel Spacing="5">
                          <TextBlock Text="RETAINED ARTIFACT" Classes="eyebrow" />
                          <TextBlock Text="Copy an exact relative path from a native panel. The service verifies the retained file hash before returning its content."
                                     Classes="caption" TextWrapping="Wrap" />
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding NativeArtifactPath, Mode=TwoWay}"
                                     Watermark="lanes/... or comparison/report.json"
                                     FontFamily="{StaticResource Font.Data}"
                                     AutomationProperties.Name="Native retained artifact path" />
                            <Button Grid.Column="1" Classes="ghost" Content="Load artifact"
                                    Command="{Binding LoadNativeArtifactCommand}" Margin="7,0,0,0"
                                    AutomationProperties.Name="Load hash checked retained artifact" />
                          </Grid>
                          <TextBlock Text="{Binding NativeArtifactStatus}" Classes="caption"
                                     TextWrapping="Wrap" />
                          <TextBox Text="{Binding NativeArtifactContent, Mode=OneWay}"
                                   IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                   FontFamily="{StaticResource Font.Data}" MinHeight="140"
                                   IsVisible="{Binding HasNativeArtifactContent}"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                   AutomationProperties.Name="Retained artifact content" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </Border>

                <Border Grid.Row="0" IsVisible="{Binding ShowBuildBusyStop}"
                        Background="{StaticResource Ai.Soft}"
                        BorderBrush="{StaticResource Ai.Glow.Brush}" BorderThickness="1"
                        CornerRadius="5" Padding="9,8" Margin="0,0,0,8"
                        AutomationProperties.Name="Active build task">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding WorkingVerb}" FontWeight="SemiBold"
                                 Foreground="{StaticResource Ai.Text.Brush}" />
                      <TextBlock Text="{Binding StepText}" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" Content="■  Stop"
                            Command="{Binding StopCommand}" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Stop active build task" />
                  </Grid>
                </Border>

                <Border Grid.Row="0" IsVisible="{Binding ShowBuildGenerationProgress}"
                        Background="{StaticResource Ai.Soft}"
                        BorderBrush="{StaticResource Ai.Glow.Brush}" BorderThickness="1"
                        CornerRadius="5" Padding="9,8" Margin="0,0,0,8"
                        MaxHeight="400"
                        AutomationProperties.Name="Live four-lane generation board">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="7" Margin="0,0,3,0">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="Building four candidates" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ai.Text.Brush}" />
                        <TextBlock Text="Four initial AI requests; an invalid lane may make one visible repair request."
                                   Classes="caption" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GenerationProgressSummary}"
                                   Classes="caption" FontFamily="{StaticResource Font.Data}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ElapsedCompact}" Classes="caption"
                                   FontFamily="{StaticResource Font.Data}"
                                   HorizontalAlignment="Right" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="ghost" Content="■  Stop"
                              Command="{Binding StopCommand}"
                              Margin="10,0,0,0" VerticalAlignment="Center"
                              AutomationProperties.Name="Stop implementation generation" />
                    </Grid>
                    <ListBox Classes="chromeLess"
                             ItemsSource="{Binding GenerationLaneProgressRows}"
                             SelectedItem="{Binding SelectedGenerationLaneProgressRow, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Margin" Value="0" />
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{StaticResource Background.Elevated}"
                                  BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                  CornerRadius="4" Padding="8,6" Margin="0,2">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding AgentName}"
                                           FontWeight="SemiBold" FontSize="10.5" />
                                <TextBlock Text="{Binding LaneName}" Classes="caption" />
                              </StackPanel>
                              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StateLabel}"
                                         Foreground="{StaticResource Ai.Text.Brush}"
                                         FontFamily="{StaticResource Font.Data}" FontSize="9" />
                              <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4"
                                          Margin="0,2,0,0">
                                <TextBlock Text="{Binding ArtifactName}" Classes="caption"
                                           FontFamily="{StaticResource Font.Data}" />
                                <TextBlock Text="·" Classes="caption" />
                                <TextBlock Text="{Binding PurposeText}" Classes="caption" />
                              </StackPanel>
                              <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding PipelineText}"
                                         Foreground="{StaticResource Ai.Text.Brush}"
                                         FontFamily="{StaticResource Font.Data}" FontSize="8.5"
                                         Margin="0,3,0,0" />
                              <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding StateDetail}"
                                         Classes="caption" TextWrapping="Wrap" Margin="0,2,0,0" />
                              <TextBlock Grid.Row="4" Grid.ColumnSpan="2"
                                         IsVisible="{Binding HasResult}"
                                         Text="SELECT TO INSPECT EXACT RESULT"
                                         Foreground="{StaticResource Ai.Text.Brush}"
                                         FontFamily="{StaticResource Font.Data}" FontSize="8.5"
                                         Margin="0,4,0,0" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Border IsVisible="{Binding SelectedGenerationLaneProgressRow.HasResult}"
                            Background="{StaticResource Background.Base}"
                            BorderBrush="{StaticResource Ai.Glow.Brush}" BorderThickness="1"
                            CornerRadius="4" Padding="8,7"
                            AutomationProperties.Name="Live lane exact result preview">
                      <StackPanel Spacing="4">
                        <TextBlock Text="LIVE RESULT · READ ONLY · NOT COMMITTED"
                                   Foreground="{StaticResource Warning.Brush}"
                                   FontFamily="{StaticResource Font.Data}"
                                   FontWeight="SemiBold" FontSize="9" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0"
                                     Text="{Binding SelectedGenerationLaneProgressRow.PreviewHeading}"
                                     Classes="eyebrow" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding SelectedGenerationLaneProgressRow.ResultOption.StatusText}"
                                     Classes="caption" FontFamily="{StaticResource Font.Data}"
                                     Foreground="{StaticResource Ai.Text.Brush}"
                                     TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                        </Grid>
                        <Border IsVisible="{Binding SelectedGenerationLaneProgressRow.ResultOption.IsFailed}"
                                Background="{StaticResource Warning.Soft}"
                                BorderBrush="{StaticResource Warning.Brush}" BorderThickness="1"
                                CornerRadius="4" Padding="6,5">
                          <StackPanel Spacing="2">
                            <TextBlock FontSize="9.5" TextWrapping="Wrap">
                              <Run Text="{Binding SelectedGenerationLaneProgressRow.ResultOption.FirstIssueCode}"
                                   FontWeight="SemiBold" />
                              <Run Text="  ·  " />
                              <Run Text="{Binding SelectedGenerationLaneProgressRow.ResultOption.FirstIssuePath}" />
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedGenerationLaneProgressRow.ResultOption.FirstIssueMessage}"
                                       Classes="caption" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                        <TextBox Text="{Binding SelectedGenerationLaneProgressRow.InspectablePreview, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 MinHeight="72" MaxHeight="132" Padding="7,5"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0"
                                 FontFamily="{StaticResource Font.Data}" FontSize="10"
                                 AutomationProperties.Name="{Binding SelectedGenerationLaneProgressRow.PreviewHeading}" />
                      </StackPanel>
                    </Border>
                    <StackPanel Spacing="1" Margin="1,2,1,0">
                      <TextBlock IsVisible="{Binding HasRetainedCandidateBatchDuringGeneration}"
                                 Text="Your last completed candidate batch remains below and will only be replaced after the new batch validates."
                                 Foreground="{StaticResource Bullish.Brush}"
                                 Classes="caption" TextWrapping="Wrap" />
                      <TextBlock Text="After all four: compare drafts → synthesize reviewed TradeIR."
                                 Classes="caption" TextWrapping="Wrap" />
                      <TextBlock Text="Nothing is compiled, tested, run, or backtested here."
                                 Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                  </ScrollViewer>
                </Border>

                <Grid Grid.Row="1" IsVisible="{Binding ShowCandidateEmptyState}">
                  <StackPanel IsVisible="{Binding !IsGeneratingCandidates}"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              MaxWidth="300" Spacing="7">
                    <StackPanel IsVisible="{Binding !HasCandidateRestoreWarning}" Spacing="7">
                      <TextBlock Text="{Binding CandidateEmptyTitle}" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding CandidateEmptyText}"
                                 Classes="caption" TextWrapping="Wrap" TextAlignment="Center" />
                      <Button Classes="aiAction" Content="Generate implementations"
                              Command="{Binding GenerateFourCandidatesCommand}"
                              IsEnabled="{Binding CanGenerateFourCandidates}"
                              IsVisible="{Binding ShowStartImplementationAction}"
                              HorizontalAlignment="Center"
                              AutomationProperties.Name="Start implementation generation" />
                    </StackPanel>
                    <Border IsVisible="{Binding HasCandidateRestoreWarning}"
                            Padding="12,10" CornerRadius="6"
                            Background="{StaticResource Warning.Soft}"
                            BorderBrush="{StaticResource Warning.Brush}" BorderThickness="1"
                            AutomationProperties.Name="Saved candidate recovery">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Saved candidates need fresh generation"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Warning.Brush}" />
                        <TextBlock Text="{Binding CandidateRestoreWarning}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Nothing was sent automatically. Review the recovered brief and reconfirm the strategy request first."
                                   Classes="caption" TextWrapping="Wrap" />
                        <Button Classes="aiAction"
                                Content="Review recovered request"
                                Command="{Binding RegenerateRecoveredCandidatesCommand}"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Review recovered strategy request" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowBuildCandidateResults}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Scrollable candidate results">
                  <StackPanel Margin="0,0,4,0">
                  <Border Margin="0,0,0,7" Padding="9,8"
                          Background="{StaticResource Background.Elevated}"
                          BorderBrush="{StaticResource Ai.Glow.Brush}" BorderThickness="1"
                          CornerRadius="5"
                          AutomationProperties.Name="Candidate outcome and next steps">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="1">
                          <TextBlock Text="CANDIDATE OUTCOME" Classes="eyebrow" />
                          <TextBlock Text="{Binding CandidateBatchHeadline}"
                                     FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="4 AI lanes" Classes="caption"
                                   FontFamily="{StaticResource Font.Data}"
                                   VerticalAlignment="Center" />
                      </Grid>

                      <Border IsVisible="{Binding CandidateBatchRestored}"
                              Background="{StaticResource Warning.Soft}"
                              BorderBrush="{StaticResource Warning.Brush}" BorderThickness="1"
                              CornerRadius="4" Padding="7,6"
                              AutomationProperties.Name="Restored candidate snapshot notice">
                        <StackPanel Spacing="4">
                          <TextBlock Text="RESTORED RESULT · NOT A NEW AI RUN"
                                     Foreground="{StaticResource Warning.Brush}"
                                     FontWeight="SemiBold" FontSize="10" />
                          <TextBlock Text="These are the saved results from before the restart. Invalid lanes stay visible as evidence; they do not become valid when the app is updated. Generate a fresh batch to use the current parser and repair pass."
                                     Classes="caption" TextWrapping="Wrap" />
                          <Button Classes="ghost" Content="Generate fresh 4 candidates"
                                  Command="{Binding RegenerateFourCandidatesCommand}"
                                  HorizontalAlignment="Left"
                                  AutomationProperties.Name="Generate fresh candidates from restored result" />
                        </StackPanel>
                      </Border>

                      <Border IsVisible="{Binding HasPendingFourLanePrompt}"
                              Background="{StaticResource Warning.Soft}"
                              BorderBrush="{StaticResource Warning.Brush}" BorderThickness="1"
                              CornerRadius="4" Padding="7,6"
                              AutomationProperties.Name="Pending strategy refinement">
                        <StackPanel Spacing="2">
                          <TextBlock Text="PENDING REQUEST NOT APPLIED"
                                     Foreground="{StaticResource Warning.Brush}"
                                     FontWeight="SemiBold" FontSize="10" />
                          <TextBlock Text="These cards are the previous completed batch. A stopped or failed refinement is back in the composer; select Check &amp; generate to apply it. Selection, revalidation, and synthetic testing stay disabled until then."
                                     Classes="caption" TextWrapping="Wrap" />
                          <Button Classes="ghost" Content="Discard pending request"
                                  Command="{Binding DiscardPendingFourLanePromptCommand}"
                                  HorizontalAlignment="Left"
                                  AutomationProperties.Name="Discard pending strategy request"
                                  ToolTip.Tip="Keeps the previous completed batch and exact hashes. Does not generate, select, synthesize, test, or backtest." />
                        </StackPanel>
                      </Border>

                      <Border IsVisible="{Binding HasBlockedGeneratedCandidates}"
                              Background="{StaticResource Warning.Soft}"
                              BorderBrush="{StaticResource Warning.Brush}" BorderThickness="1"
                              CornerRadius="4" Padding="6,4"
                              ToolTip.Tip="{Binding FirstBlockedGeneratedCandidateOption.FirstIssueMessage}">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                          <TextBlock Grid.Row="0" Grid.Column="0"
                                     Text="{Binding FirstBlockedGeneratedCandidateOption.LaneName}"
                                     Foreground="{StaticResource Warning.Brush}"
                                     FontWeight="SemiBold" FontSize="10" Margin="0,0,6,0" />
                          <TextBlock Grid.Row="0" Grid.Column="1"
                                     Text="{Binding FirstBlockedGeneratedCandidateOption.FirstIssueCode}"
                                     FontFamily="{StaticResource Font.Data}" FontSize="9.5"
                                     TextWrapping="Wrap" />
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                     Text="{Binding FirstBlockedGeneratedCandidateOption.FirstIssuePath}"
                                     Classes="caption" FontFamily="{StaticResource Font.Data}"
                                     TextWrapping="Wrap" Margin="0,2,0,0" />
                          <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                     Text="{Binding FirstBlockedGeneratedCandidateOption.FirstIssueMessage}"
                                     Classes="caption" TextTrimming="CharacterEllipsis"
                                     Margin="0,2,0,0" />
                        </Grid>
                      </Border>

                      <TextBlock Text="Generated = structurally shaped draft only — not proven correct, runnable, tested, or backtest-ready."
                                 Classes="caption" TextWrapping="Wrap" />

                      <StackPanel Spacing="1" IsVisible="{Binding HasChosenGeneratedCandidate}">
                        <TextBlock Text="{Binding ChosenGeneratedCandidateSummary}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource Bullish.Brush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" FontFamily="{StaticResource Font.Data}"
                                   TextTrimming="CharacterEllipsis">
                          <Run Text="SHA-256  " />
                          <Run Text="{Binding ChosenGeneratedCandidateHash}" />
                        </TextBlock>
                      </StackPanel>

                      <Grid ColumnDefinitions="*,*" Margin="0,3,0,1">
                        <Border Grid.Column="0" Margin="0,0,3,0" Padding="7,6"
                                Background="{StaticResource Background.Base}"
                                BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                CornerRadius="4"
                                AutomationProperties.Name="Candidate generation action">
                          <StackPanel Spacing="4">
                            <TextBlock Text="GENERATE / REGENERATE" Classes="eyebrow" />
                            <TextBlock Text="Creates four replacement drafts only. It does not compile, test, run, or backtest."
                                       Classes="caption" TextWrapping="Wrap" />
                            <Button Classes="ghost" Content="Regenerate 4 candidates"
                                    Command="{Binding RegenerateFourCandidatesCommand}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Regenerate four candidate drafts"
                                    ToolTip.Tip="Starts four model calls with the preserved strategy brief; each invalid lane may make one repair call. It does not run a test or backtest." />
                            <TextBlock Text="Uses the preserved brief. Add a composer refinement and use Check &amp; generate to change it."
                                       Classes="caption" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="3,0,0,0" Padding="7,6"
                                Background="{StaticResource Background.Base}"
                                BorderBrush="{StaticResource Ai.Glow.Brush}" BorderThickness="1"
                                CornerRadius="4"
                                AutomationProperties.Name="Candidate synthetic test action">
                          <StackPanel Spacing="4">
                            <TextBlock Text="TEST · SYNTHETIC ONLY" Classes="eyebrow" />
                            <TextBlock Text="1 Preview Graph · Typed  →  2 Use selected in editor  →  3 Run exact-hash smoke"
                                       Classes="caption" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CandidateBacktestAvailabilityText}"
                                       Foreground="{StaticResource Warning.Brush}"
                                       FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Button Classes="aiAction" Content="{Binding BacktestActionText}"
                                    Command="{Binding RunTradeIrSimulatedBacktestCommand}"
                                    IsEnabled="{Binding CanPrepareGeneratedCandidateForBacktest}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Run exact-hash synthetic smoke"
                                    ToolTip.Tip="Enabled only for the unchanged package-valid TradeIR artifact active in the editor. Admission and execution use deterministic synthetic QuoteL1 data." />
                            <TextBlock Text="Historical backtest unavailable here · Backtest Studio is a separate workflow."
                                       Classes="caption" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </Grid>

                      <WrapPanel HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="Load QuoteL1 EMA smoke starter"
                                Command="{Binding UseQuoteL1EmaSmokeStarterCommand}"
                                IsEnabled="{Binding !IsGenerating}"
                                Margin="0,2,6,0"
                                ToolTip.Tip="Loads the known smoke-compatible brief into the composer for review; it does not generate or run anything." />
                        <Button Classes="ghost" Content="Expert C# (separate path)"
                                Command="{Binding ToggleGenerationModeCommand}"
                                Margin="0,2,6,0"
                                ToolTip.Tip="Switches authoring mode only. Ask the agent to reimplement the brief as C# before Compile &amp; Register." />
                        <Button Classes="ghost" Content="Revalidate edit"
                                Command="{Binding RevalidateGeneratedCandidateCommand}"
                                IsEnabled="{Binding CanRevalidateGeneratedCandidate}"
                                Margin="0,2,6,0"
                                ToolTip.Tip="Hashes the artifact currently loaded in the editor, reruns its deterministic format checks, and uses a package validator when one is registered; no model call, test, import, or execution occurs." />
                        <Button Classes="aiAction" Content="{Binding CandidateActionText}"
                                Command="{Binding ChooseGeneratedCandidateCommand}"
                                IsEnabled="{Binding CanChooseGeneratedCandidate}"
                                Margin="0,2,0,0"
                                ToolTip.Tip="Loads this exact artifact into the existing editor; no model call or execution occurs." />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <ListBox Classes="chromeLess"
                           ItemsSource="{Binding GeneratedCandidateOptions}"
                           SelectedItem="{Binding SelectedGeneratedCandidateOption, Mode=TwoWay}"
                           AutomationProperties.Name="Four generated candidate results">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="2" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid MinHeight="124" Margin="3">
                          <Border Background="{StaticResource Background.Elevated}"
                                  BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                  CornerRadius="5" />
                          <Border IsVisible="{Binding IsPreviewed}"
                                  BorderBrush="{StaticResource Ai.Glow.Brush}" BorderThickness="2"
                                  CornerRadius="5" IsHitTestVisible="False" />
                          <Border IsVisible="{Binding IsChosen}"
                                  BorderBrush="{StaticResource Bullish.Brush}" BorderThickness="0,0,0,3"
                                  CornerRadius="5" IsHitTestVisible="False" />
                          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="8,7">
                            <TextBlock Grid.Row="0" Text="{Binding LaneName}"
                                       FontWeight="SemiBold" FontSize="10.5"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Text="{Binding StatusText}"
                                       Classes="caption" FontFamily="{StaticResource Font.Data}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,4,0,2">
                              <Border IsVisible="{Binding IsPreviewed}"
                                      Background="{StaticResource Ai.Soft}"
                                      BorderBrush="{StaticResource Ai.Glow.Brush}" BorderThickness="1"
                                      CornerRadius="8" Padding="5,1">
                                <TextBlock Text="PREVIEW" FontSize="8" FontWeight="Bold"
                                           Foreground="{StaticResource Ai.Text.Brush}" />
                              </Border>
                              <Border IsVisible="{Binding IsChosen}"
                                      Background="{StaticResource Bullish.Soft}"
                                      BorderBrush="{StaticResource Bullish.Brush}" BorderThickness="1"
                                      CornerRadius="8" Padding="5,1">
                                <TextBlock Text="ACTIVE IN EDITOR" FontSize="8" FontWeight="Bold"
                                           Foreground="{StaticResource Bullish.Brush}" />
                              </Border>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="{Binding Representation}"
                                       Classes="caption" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="4" Text="{Binding ArtifactName}" Classes="caption"
                                       FontFamily="{StaticResource Font.Data}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            <TextBlock Grid.Row="5" Text="{Binding FlexibilityText}"
                                       Classes="caption" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="6" Text="{Binding SyntheticTestCapabilityText}"
                                       Classes="caption" FontFamily="{StaticResource Font.Data}"
                                       Foreground="{StaticResource Ai.Text.Brush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                            <TextBlock Grid.Row="7" Text="SELECT TO INSPECT EXACT RESULT"
                                       Foreground="{StaticResource Ai.Text.Brush}"
                                       FontFamily="{StaticResource Font.Data}" FontSize="8"
                                       Margin="0,4,0,0" />
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <Border Background="{StaticResource Background.Elevated}"
                          BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                          CornerRadius="5" Padding="9,8" Margin="3,7,3,0"
                          AutomationProperties.Name="Selected candidate exact result preview">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding SelectedGeneratedCandidateOption.PreviewStateText}"
                                 Foreground="{StaticResource Ai.Text.Brush}"
                                 FontFamily="{StaticResource Font.Data}"
                                 FontWeight="SemiBold" FontSize="9" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedGeneratedCandidateOption.PreviewHeading}"
                                   Classes="eyebrow" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedGeneratedCandidateOption.StatusText}"
                                   Classes="caption" FontFamily="{StaticResource Font.Data}"
                                   Foreground="{StaticResource Ai.Text.Brush}"
                                   TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                      </Grid>
                      <Border IsVisible="{Binding SelectedGeneratedCandidateOption.IsFailed}"
                              Background="{StaticResource Warning.Soft}"
                              BorderBrush="{StaticResource Warning.Brush}" BorderThickness="1"
                              CornerRadius="4" Padding="6,5">
                        <StackPanel Spacing="2">
                          <TextBlock FontSize="9.5" TextWrapping="Wrap">
                            <Run Text="{Binding SelectedGeneratedCandidateOption.FirstIssueCode}"
                                 FontWeight="SemiBold" />
                            <Run Text="  ·  " />
                            <Run Text="{Binding SelectedGeneratedCandidateOption.FirstIssuePath}" />
                          </TextBlock>
                          <TextBlock Text="{Binding SelectedGeneratedCandidateOption.FirstIssueMessage}"
                                     Classes="caption" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding SelectedGeneratedCandidateOption.RecoveryText}"
                                     Classes="caption" TextWrapping="Wrap"
                                     Foreground="{StaticResource Warning.Brush}" />
                          <Button Classes="ghost" Content="Generate fresh 4 candidates"
                                  Command="{Binding RegenerateFourCandidatesCommand}"
                                  HorizontalAlignment="Left"
                                  AutomationProperties.Name="Regenerate after selected candidate failure" />
                        </StackPanel>
                      </Border>
                      <TextBox Text="{Binding SelectedGeneratedCandidateOption.InspectablePreview, Mode=OneWay}"
                               IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                               MinHeight="72" MaxHeight="150" Padding="7,5"
                               ScrollViewer.HorizontalScrollBarVisibility="Auto"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                               Background="Transparent" BorderThickness="0"
                               FontFamily="{StaticResource Font.Data}" FontSize="10"
                               AutomationProperties.Name="{Binding SelectedGeneratedCandidateOption.PreviewHeading}" />
                    </StackPanel>
                  </Border>

                  <Border Background="{StaticResource Background.Elevated}"
                          BorderBrush="{StaticResource Ai.Glow.Brush}" BorderThickness="1"
                          CornerRadius="5" Padding="9,8" Margin="3,7,3,8"
                          AutomationProperties.Name="TradeIR synthesis bridge">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="1">
                          <TextBlock Text="COMBINED TRADEIR · FIFTH ARTIFACT" Classes="eyebrow" />
                          <TextBlock Text="Reconcile every selectable draft into one canonical target"
                                     FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CombinedTradeIrStatusText}"
                                   Classes="caption" FontFamily="{StaticResource Font.Data}"
                                   Foreground="{StaticResource Ai.Text.Brush}"
                                   TextWrapping="Wrap" TextAlignment="Right" MaxWidth="145"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                      </Grid>

                      <TextBlock Text="{Binding CombinedTradeIrSourceSummary}"
                                 Classes="caption" TextWrapping="Wrap" />
                      <TextBlock Text="This is one additional AI call and one new hash-bound artifact. It never overwrites the four source drafts and is not deterministic compilation."
                                 Classes="caption" TextWrapping="Wrap" />

                      <StackPanel IsVisible="{Binding IsSynthesizingTradeIr}" Spacing="4">
                        <TextBlock Text="Synthesizing agreements, conflicts, assumptions, and missing facts…"
                                   FontSize="10" Foreground="{StaticResource Ai.Text.Brush}"
                                   TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" Height="3" />
                      </StackPanel>

                      <Border IsVisible="{Binding HasCombinedTradeIrSynthesis}"
                              Background="{StaticResource Background.Base}"
                              BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                              CornerRadius="4" Padding="7,5">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="caption" FontFamily="{StaticResource Font.Data}"
                                     TextTrimming="CharacterEllipsis">
                            <Run Text="TARGET  " /><Run Text="{Binding CombinedTradeIrTargetHash}" />
                          </TextBlock>
                          <TextBlock Classes="caption" FontFamily="{StaticResource Font.Data}"
                                     TextTrimming="CharacterEllipsis">
                            <Run Text="RECEIPT " /><Run Text="{Binding CombinedTradeIrReceiptHash}" />
                          </TextBlock>
                          <TextBlock Text="{Binding CombinedTradeIrIssueText}"
                                     Classes="caption" TextWrapping="Wrap"
                                     Foreground="{StaticResource Warning.Brush}" />
                        </StackPanel>
                      </Border>

                      <TextBlock Text="After loading the combined TradeIR, you can run the same closed-target synthetic smoke test. Admission still checks exact data binding and runtime artifacts at run time."
                                 Classes="caption" TextWrapping="Wrap"
                                 Foreground="{StaticResource Warning.Brush}" />

                      <WrapPanel HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="Synthesize valid drafts → TradeIR"
                                Command="{Binding SynthesizeTradeIrCommand}"
                                IsEnabled="{Binding CanSynthesizeTradeIr}"
                                Margin="0,2,6,0"
                                AutomationProperties.Name="Synthesize valid drafts to TradeIR"
                                ToolTip.Tip="Uses every selectable lane result by exact candidate hash and makes one additional AI call." />
                        <Button Classes="aiAction" Content="{Binding CombinedTradeIrActionText}"
                                Command="{Binding UseCombinedTradeIrCommand}"
                                IsEnabled="{Binding CanUseCombinedTradeIr}"
                                Margin="0,2,0,0"
                                AutomationProperties.Name="Use combined TradeIR in editor"
                                ToolTip.Tip="Loads the exact synthesized TradeIR artifact into the editor. It does not import, test, backtest, or run it." />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border IsVisible="{Binding HasBacktestReadinessContext}"
                          Background="{StaticResource Background.Elevated}"
                          BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                          CornerRadius="5" Padding="8" Margin="3,7,3,8">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding BacktestReadinessTitle}" Classes="eyebrow" />
                        <TextBlock Text="{Binding BacktestReadinessText}" Classes="caption"
                                   TextWrapping="Wrap" MaxWidth="310" />
                      </StackPanel>
                      <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                    ItemsSource="{Binding BacktestReadinessStages}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="2" Rows="2" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="18,*,Auto" Margin="2,2,8,2"
                                  ToolTip.Tip="{Binding Detail}">
                              <TextBlock Grid.Column="0" Text="{Binding Step}" Classes="caption"
                                         FontFamily="{StaticResource Font.Data}" />
                              <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="10" />
                              <TextBlock Grid.Column="2" Text="{Binding Status}" Classes="caption"
                                         FontFamily="{StaticResource Font.Data}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,7,0,0" Padding="7,6"
                              Background="{StaticResource Background.Base}"
                              BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                              CornerRadius="4"
                              AutomationProperties.Name="TradeIR synthetic smoke result">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="SYNTHETIC SMOKE RESULT" Classes="eyebrow" />
                            <TextBlock Grid.Column="1" Text="{Binding TradeIrBacktestStatusText}"
                                       Classes="caption" FontFamily="{StaticResource Font.Data}"
                                       Foreground="{StaticResource Ai.Text.Brush}" />
                          </Grid>
                          <TextBlock Text="{Binding TradeIrBacktestSummary}"
                                     FontSize="10" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding TradeIrBacktestIssueText}"
                                     Classes="caption" Foreground="{StaticResource Warning.Brush}"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding TradeIrBacktestBoundaryText}"
                                     Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                      <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                                 Text="A passed smoke proves this exact graph can be admitted and executed against the bundled synthetic feed. Historical TradeIR backtesting is not connected yet; Backtest Studio remains a separate workflow."
                                 Classes="caption" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </Grid>
                  </Border>

                  <StackPanel Margin="0,8,0,0" Spacing="8">
                    <Border IsVisible="{Binding SelectedGeneratedCandidateOption.IsFailed}"
                            Background="{StaticResource Warning.Soft}"
                            BorderBrush="{StaticResource Warning.Brush}" BorderThickness="1"
                            CornerRadius="4" Padding="8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SelectedGeneratedCandidateOption.FailureHeading}" Classes="eyebrow" />
                        <TextBlock Text="{Binding SelectedGeneratedCandidateOption.ErrorText}"
                                   TextWrapping="Wrap" FontSize="10.5" />
                      </StackPanel>
                    </Border>

                    <StackPanel IsVisible="{Binding HasSelectedGeneratedCandidate}">
                      <StackPanel Spacing="10" Margin="0,0,4,0">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding SelectedGeneratedCandidateOption.Candidate.Title}"
                                     FontWeight="SemiBold" FontSize="13" />
                          <TextBlock Classes="caption" FontFamily="{StaticResource Font.Data}">
                            <Run Text="{Binding SelectedGeneratedCandidateOption.Candidate.Artifact.FileName}" />
                            <Run Text="  ·  " />
                            <Run Text="{Binding SelectedGeneratedCandidateOption.CandidateHashSha256}" />
                          </TextBlock>
                        </StackPanel>

                        <Border Background="{StaticResource Background.Elevated}"
                                BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                CornerRadius="4" Padding="7,6">
                          <StackPanel Spacing="3">
                            <TextBlock Text="CONTRACT AUTHORITY" Classes="eyebrow" />
                            <TextBlock FontSize="10.5" TextWrapping="Wrap">
                              <Run Text="{Binding SelectedGeneratedCandidateOption.ContractRole}" FontWeight="SemiBold" />
                              <Run Text="  ·  " />
                              <Run Text="{Binding SelectedGeneratedCandidateOption.ContractVersion}" />
                            </TextBlock>
                            <TextBlock Classes="caption" TextWrapping="Wrap">
                              <Run Text="Authority: " />
                              <Run Text="{Binding SelectedGeneratedCandidateOption.ContractAuthority}" />
                              <Run Text="  ·  " />
                              <Run Text="{Binding SelectedGeneratedCandidateOption.LoweringBoundary}" />
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedGeneratedCandidateOption.CompatibilityBoundary}"
                                       Classes="caption" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedGeneratedCandidateOption.SpecificationReference}"
                                       Classes="caption" FontFamily="{StaticResource Font.Data}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <StackPanel Spacing="4">
                          <TextBlock Text="INTERPRETATION" Classes="eyebrow" />
                          <TextBlock Text="{Binding SelectedGeneratedCandidateOption.Candidate.Interpretation}"
                                     TextWrapping="Wrap" FontSize="10.5" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                          <TextBlock Text="UNRESOLVED QUESTIONS" Classes="eyebrow" />
                          <ItemsControl ItemsSource="{Binding SelectedGeneratedCandidateOption.Candidate.UnresolvedQuestions}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Classes="caption" Margin="0,1" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="4">
                          <TextBlock Text="ASSUMPTIONS" Classes="eyebrow" />
                          <ItemsControl ItemsSource="{Binding SelectedGeneratedCandidateOption.Candidate.Assumptions}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Classes="caption" Margin="0,1" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="4">
                          <TextBlock Text="PROPOSED PARAMETERS" Classes="eyebrow" />
                          <ItemsControl ItemsSource="{Binding SelectedGeneratedCandidateOption.Candidate.Parameters}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Background="{StaticResource Background.Elevated}"
                                        BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                        CornerRadius="4" Padding="7,5" Margin="0,2">
                                  <StackPanel Spacing="2">
                                    <TextBlock FontSize="10.5">
                                      <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                      <Run Text=" = " /><Run Text="{Binding DefaultValue}" />
                                      <Run Text="  " /><Run Text="{Binding Unit}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="4">
                          <TextBlock Text="PROPOSED FORKS" Classes="eyebrow" />
                          <ItemsControl ItemsSource="{Binding SelectedGeneratedCandidateOption.Candidate.VariationAxes}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Spacing="1" Margin="0,2">
                                  <TextBlock FontSize="10.5">
                                    <Run Text="{Binding AxisId}" FontWeight="SemiBold" />
                                    <Run Text="  ·  " /><Run Text="{Binding Kind}" />
                                  </TextBlock>
                                  <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" />
                                  <ItemsControl ItemsSource="{Binding Choices}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <TextBlock Text="{Binding}" Classes="caption" Margin="6,0,0,0" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="4">
                          <TextBlock Text="EDITING NOTES" Classes="eyebrow" />
                          <TextBlock Text="{Binding SelectedGeneratedCandidateOption.Candidate.Explanation}"
                                     TextWrapping="Wrap" Classes="caption" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                          <TextBlock Text="ARTIFACT PREVIEW" Classes="eyebrow" />
                          <Border Background="{StaticResource Background.Elevated}"
                                  BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                  CornerRadius="4">
                            <TextBox Text="{Binding SelectedGeneratedCandidateOption.ArtifactPreview, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     MinHeight="96" MaxHeight="260" Padding="8,6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="{StaticResource Font.Data}" FontSize="10.5" />
                          </Border>
                        </StackPanel>

                        <StackPanel Spacing="4">
                          <TextBlock Text="PROPOSED TESTS" Classes="eyebrow" />
                          <ItemsControl ItemsSource="{Binding SelectedGeneratedCandidateOption.Candidate.ProposedTests}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Classes="caption" Margin="0,1" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                  </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" IsVisible="{Binding ShowDesignCandidateReview}" RowDefinitions="Auto,*">
                  <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding CurrentCandidate.Title}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Classes="caption" FontFamily="{StaticResource Font.Data}">
                          <Run Text="revision " /><Run Text="{Binding CurrentCandidate.Revision}" />
                          <Run Text="  ·  " /><Run Text="{Binding CurrentCandidate.Status}" />
                        </TextBlock>
                      </StackPanel>
                      <Button Grid.Column="1" Classes="aiAction" Content="Confirm meaning"
                              Command="{Binding ConfirmCandidateCommand}"
                              IsEnabled="{Binding CanConfirmCandidate}"
                              ToolTip.Tip="Confirms the exact displayed candidate hash; it does not generate code." />
                    </Grid>
                    <TextBlock Text="{Binding CandidateStatusText}" Classes="caption" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CandidateContentHash}" Classes="caption"
                               FontFamily="{StaticResource Font.Data}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Margin="0,0,4,0">
                      <StackPanel Spacing="4">
                        <TextBlock Text="INPUT" Classes="eyebrow" />
                        <TextBlock Text="{Binding CurrentCandidate.RawIntent}"
                                   TextWrapping="Wrap" FontSize="11" />
                      </StackPanel>

                      <StackPanel Spacing="4">
                        <TextBlock Text="INTERPRETATION" Classes="eyebrow" />
                        <TextBlock Text="{Binding CurrentCandidate.Interpretation.Summary}"
                                   TextWrapping="Wrap" FontSize="11" />
                        <ItemsControl ItemsSource="{Binding CurrentCandidate.Interpretation.Alternatives}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,2,0,0">
                                <Run Text="Other reading: " FontWeight="SemiBold" />
                                <Run Text="{Binding Summary}" />
                              </TextBlock>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <Border AutomationProperties.Name="Strategy request review"
                              IsVisible="{Binding HasStrategyIntentReview}"
                              Background="{StaticResource Background.Elevated}"
                              BorderBrush="{StaticResource Ai.Glow.Brush}" BorderThickness="1"
                              CornerRadius="5" Padding="8,7">
                        <StackPanel Spacing="9">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                              <TextBlock Text="STRATEGY REQUEST · REVIEW" Classes="eyebrow" />
                              <TextBlock Text="Observe → qualify evidence → decide intent → size/exposure → execution → manage lifecycle → finish/unwind"
                                         Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="aiAction" Content="Confirm strategy request"
                                    Command="{Binding ConfirmStrategyIntentReviewCommand}"
                                    IsEnabled="{Binding CanConfirmStrategyIntentReview}"
                                    ToolTip.Tip="Locks the reviewed research case and strategy decisions before implementation agents may start." />
                          </Grid>
                          <TextBlock Text="{Binding StrategyIntentStatusText}" Classes="caption" TextWrapping="Wrap" />

                          <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="3">
                              <TextBlock Text="STRATEGY PROFILE" Classes="eyebrow" />
                              <ComboBox ItemsSource="{Binding StrategyIntentProfiles}"
                                        SelectedItem="{Binding SelectedStrategyIntentProfile, Mode=TwoWay}"
                                        MinWidth="220" />
                              <TextBlock Text="{Binding SelectedStrategyIntentProfile.Summary}"
                                         Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3" Margin="8,0,0,0">
                              <TextBlock Text="DECISION SHAPE" Classes="eyebrow" />
                              <ComboBox ItemsSource="{Binding StrategyIntentShapes}"
                                        SelectedItem="{Binding SelectedStrategyIntentShape, Mode=TwoWay}"
                                        MinWidth="220" />
                              <TextBlock Text="{Binding SelectedStrategyIntentShape.Summary}"
                                         Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                          </Grid>
                          <TextBlock Text="{Binding StrategyIntentFamilyText}" Classes="caption"
                                     FontWeight="SemiBold" TextWrapping="Wrap" />

                          <Border BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                  CornerRadius="4" Padding="7,6">
                            <StackPanel Spacing="6">
                              <TextBlock Text="RESEARCH CASE" Classes="eyebrow" />
                              <TextBlock Text="Objective" Classes="caption" />
                              <TextBox Text="{Binding StrategyResearchObjective, Mode=TwoWay}"
                                       Watermark="What decision or outcome is this research trying to improve?"
                                       TextWrapping="Wrap" />
                              <TextBlock Text="Hypothesis" Classes="caption" />
                              <TextBox Text="{Binding StrategyResearchHypothesis, Mode=TwoWay}"
                                       Watermark="What testable market relationship do you expect?"
                                       TextWrapping="Wrap" />
                              <TextBlock Text="EVIDENCE TO OBSERVE" Classes="eyebrow" Margin="0,3,0,0" />
                              <ItemsControl ItemsSource="{Binding StrategyResearchEvidenceRows}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                            CornerRadius="4" Padding="7,6" Margin="0,2">
                                      <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding MaterialityLabel}" Classes="caption"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Description, Mode=TwoWay}"
                                                 Watermark="Prices, volume, comparison instruments, indicators, regime, or events"
                                                 TextWrapping="Wrap" />
                                        <TextBlock Text="Point-in-time and freshness rule" Classes="caption" />
                                        <TextBox Text="{Binding PointInTimeRule, Mode=TwoWay}"
                                                 Watermark="Which completed data is available at each decision time, and how fresh must it be?"
                                                 TextWrapping="Wrap" />
                                        <TextBlock Text="Qualification, conflict, and no-action rule" Classes="caption" />
                                        <TextBox Text="{Binding QualificationRule, Mode=TwoWay}"
                                                 Watermark="What confirms the evidence, and what conflict or missing input forces no action?"
                                                 TextWrapping="Wrap" />
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Text="FALSIFIERS / REJECTION CONDITIONS" Classes="eyebrow" Margin="0,3,0,0" />
                              <ItemsControl ItemsSource="{Binding StrategyResearchFalsifierRows}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                            CornerRadius="4" Padding="7,6" Margin="0,2">
                                      <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding MaterialityLabel}" Classes="caption"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Description, Mode=TwoWay}"
                                                 Watermark="What result or data defect would reject this idea?"
                                                 TextWrapping="Wrap" />
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <ItemsControl ItemsSource="{Binding StrategyResearchUnresolvedRows}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                            CornerRadius="4" Padding="7,6" Margin="0,2">
                                      <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding MaterialityLabel}" Classes="caption"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Description, Mode=TwoWay}" TextWrapping="Wrap" />
                                        <TextBlock Text="Reviewed resolution" Classes="caption" />
                                        <TextBox Text="{Binding Resolution, Mode=TwoWay}"
                                                 Watermark="Record the explicit reviewed decision; a blank answer cannot close this item."
                                                 TextWrapping="Wrap" />
                                        <Button Content="Record resolution"
                                                Command="{Binding ResolveCommand}"
                                                IsEnabled="{Binding CanResolve}"
                                                Classes="ghost"
                                                HorizontalAlignment="Left" />
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Text="RESOLVED RESEARCH DECISIONS" Classes="eyebrow" Margin="0,3,0,0" />
                              <ItemsControl ItemsSource="{Binding StrategyResearchResolvedRows}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                            CornerRadius="4" Padding="7,6" Margin="0,2">
                                      <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding MaterialityLabel}" Classes="caption"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding OriginalDescription}" Classes="caption"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Resolution}" TextWrapping="Wrap"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ResolutionProvenance}" Classes="caption"
                                                   TextWrapping="Wrap" />
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>

                          <ItemsControl ItemsSource="{Binding StrategyIntentRequirements}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                        CornerRadius="4" Padding="7,6" Margin="0,2">
                                  <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,190">
                                      <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StageLabel}" Classes="eyebrow" />
                                        <TextBlock Text="{Binding MaterialityLabel}" Classes="caption" />
                                      </StackPanel>
                                      <ComboBox Grid.Column="1"
                                                ItemsSource="{Binding ApplicabilityOptions}"
                                                SelectedItem="{Binding SelectedApplicability, Mode=TwoWay}"
                                                IsEnabled="{Binding CanChangeApplicability}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Question}" FontSize="10.5" TextWrapping="Wrap"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Provenance.Explanation}" Classes="caption" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding Answer, Mode=TwoWay}"
                                             Watermark="{Binding AnswerWatermark}"
                                             TextWrapping="Wrap" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <StackPanel Spacing="3"
                                      IsVisible="{Binding StrategyIntentQuestions.Count, Converter={StaticResource PositiveCount}}">
                            <TextBlock Text="ANSWERS STILL REQUIRED" Classes="eyebrow" />
                            <ItemsControl ItemsSource="{Binding StrategyIntentQuestions}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock TextWrapping="Wrap" Classes="caption" Margin="0,1">
                                    <Run Text="{Binding Prompt}" />
                                    <Run Text=" — " /><Run Text="{Binding Reason}" />
                                  </TextBlock>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <StackPanel Spacing="3"
                                      IsVisible="{Binding StrategyIntentIssues.Count, Converter={StaticResource PositiveCount}}">
                            <TextBlock Text="WHY CONFIRMATION IS LOCKED" Classes="eyebrow" />
                            <ItemsControl ItemsSource="{Binding StrategyIntentIssues}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                             Classes="caption" Margin="0,1" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <TextBlock Text="Confirmation only unlocks implementation work. It is not proof that code compiles, scenarios pass, a backtest succeeds, paper trading is approved, or live trading is authorized."
                                     Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <StackPanel Spacing="4" IsVisible="{Binding CandidateOpenQuestions.Count, Converter={StaticResource PositiveCount}}">
                        <TextBlock Text="YOUR CHOICES" Classes="eyebrow" />
                        <ItemsControl ItemsSource="{Binding CandidateOpenQuestions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="{StaticResource Warning.Soft}"
                                      BorderBrush="{StaticResource Warning.Brush}" BorderThickness="1"
                                      CornerRadius="4" Padding="7,5" Margin="0,2">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="10.5" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <StackPanel Spacing="4">
                        <TextBlock Text="GROUPS AND RULES" Classes="eyebrow" />
                        <ItemsControl ItemsSource="{Binding CandidateGroups}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="{StaticResource Background.Elevated}"
                                      BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                      CornerRadius="4" Padding="7,6" Margin="0,2">
                                <StackPanel Spacing="3">
                                  <TextBlock Text="{Binding Location}" Classes="caption"
                                             FontFamily="{StaticResource Font.Data}" />
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="10.5" />
                                  <TextBlock Text="{Binding Summary}" Classes="caption" TextWrapping="Wrap" />
                                  <ItemsControl ItemsSource="{Binding Statements}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Grid ColumnDefinitions="64,*" Margin="0,2,0,0">
                                          <TextBlock Text="{Binding Kind}" Classes="caption"
                                                     FontFamily="{StaticResource Font.Data}" />
                                          <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="10.5"
                                                     TextWrapping="Wrap" />
                                        </Grid>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <StackPanel Spacing="4">
                        <TextBlock Text="BUILD SUPPORT" Classes="eyebrow" />
                        <ItemsControl ItemsSource="{Binding CandidateBuildSupport}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="{StaticResource Background.Elevated}"
                                      BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                                      CornerRadius="4" Padding="7,6" Margin="0,2">
                                <StackPanel Spacing="2">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" FontSize="10.5" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="caption"
                                               FontFamily="{StaticResource Font.Data}" />
                                  </Grid>
                                  <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="Wrap" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Grid>
            </TabItem>

          </TabControl>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Registration consent gate. No successful compile can register around this overlay. -->
    <Grid Grid.Row="1" IsVisible="{Binding ReviewOpen}">
      <Border Background="#C8101218" />
      <Border Width="900" MaxHeight="680" Margin="40"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource Background.Elevated}"
              BorderBrush="{StaticResource Ai.Glow.Brush}" BorderThickness="1"
              CornerRadius="9" Padding="18,15">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,11">
            <TextBlock Text="Review before registering" Classes="header" FontSize="17" />
            <TextBlock Text="{Binding ReviewSummary}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>

          <ListBox Grid.Row="1" Classes="chromeLess"
                   ItemsSource="{Binding ReviewFiles}"
                   SelectedItem="{Binding SelectedReviewFile, Mode=TwoWay}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontFamily="{StaticResource Font.Data}" FontSize="10.5">
                  <Run Text="{Binding Name}" /><Run Text="  " />
                  <Run Text="{Binding Counts}" Foreground="{StaticResource Bullish.Brush}" />
                </TextBlock>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="2" Background="{StaticResource Background.Surface}"
                  BorderBrush="{StaticResource Border.Brush}" BorderThickness="1"
                  CornerRadius="4" Margin="0,7,0,0" Padding="8,5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SelectedReviewFile.Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="48,*" Margin="0,1">
                      <TextBlock Grid.Column="0" Text="{Binding Kind}" Classes="caption"
                                 FontFamily="{StaticResource Font.Data}" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}"
                                 FontFamily="{StaticResource Font.Data}" FontSize="11"
                                 Foreground="{StaticResource Text.Primary}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" MaxWidth="590"
                       Text="Registering runs this code in-process. The policy scan has already rejected P/Invoke, process and registry access."
                       Classes="caption" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="Back" Command="{Binding CancelReviewCommand}" />
              <Button Classes="aiAction" Content="Register strategy"
                      Command="{Binding ConfirmRegisterCommand}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
